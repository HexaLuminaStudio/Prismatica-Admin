# PrismaticaAdmin 生产环境配置
# 跨端口部署(2026-08-06 M2 cors-fix):前端独立部署,与后端同 IP 不同端口。
# VITE_API_BASE_URL 必须直指后端,fetch 才能正确发出。
# 浏览器会自动带 cookie,需要后端配合:
#   CORS_ALLOWED_ORIGINS=http://103.236.55.211:8080
#   CORS_ALLOW_CREDENTIALS=true
#   ADMIN_COOKIE_SECURE=true
VITE_API_BASE_URL=http://103.236.55.211:8000